{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/**",
              "components/core/**",
              "components/data/**",
              "components/edm/**",
              "components/forms/**",
              "components/navigation/**",
              "components/shapes/**",
              "ui_kits/marketing/**",
              "ui_kits/saas-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|idx|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, size, idx, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:activated|unactivated|paused|warning|vip|info|draft|neutral)$/]",
        "message": "<Badge> kind must be one of 'activated' | 'unactivated' | 'paused' | 'warning' | 'vip' | 'info' | 'draft' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|labels|highlight|height|key|ref|className|style|children)$/]",
        "message": "<BarChart> doesn't accept that prop. Declared props: data, labels, highlight, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blob'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|width|height|fill|gradient|style|key|ref|className|style|children)$/]",
        "message": "<Blob> doesn't accept that prop. Declared props: shape, width, height, fill, gradient, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blob'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:bloom|sweep|slab|slabTilt|squircle|cushion|pebble)$/]",
        "message": "<Blob> shape must be one of 'bloom' | 'sweep' | 'slab' | 'slabTilt' | 'squircle' | 'cushion' | 'pebble'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Blob'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:sunsetFlat|grape|blush|meadowSweep)$/]",
        "message": "<Blob> gradient must be one of 'sunsetFlat' | 'grape' | 'blush' | 'meadowSweep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, onClick, children, style."
      },
